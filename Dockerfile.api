# ──────────────────────────────────────────────────────────────
# Dockerfile.api — FastAPI container (read-only Redis consumer)
# v3: python:3.12-slim, no browser, no Selenium/Playwright deps
# ──────────────────────────────────────────────────────────────
FROM python:3.12-slim

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# curl for HEALTHCHECK
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# API-only dependencies (no scraper packages needed here)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "fastapi==0.115.6" \
        "uvicorn[standard]==0.34.0" \
        "redis[hiredis]==5.2.1" \
        "pydantic==2.10.3"

# Application code
COPY config.py api.py ./

RUN chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 2 workers for normal VPS; override to 1 in docker-compose.lowmem.yml
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
