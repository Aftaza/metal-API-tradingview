# ── Git / VCS ─────────────────────────────────────────────────
.git
.gitignore

# ── Documentation ─────────────────────────────────────────────
README.md
docs/

# ── Docker meta-files (don't copy into image) ─────────────────
.dockerignore
Dockerfile*
docker-compose*

# ── Python cache / compiled files ─────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.Python

# ── Virtual environments ───────────────────────────────────────
env/
venv/
.venv/

# ── Secrets / environment (never copy into images!) ───────────
.env
*.env

# ── Test files ────────────────────────────────────────────────
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/

# ── Dev / editor artifacts ────────────────────────────────────
*.log
logs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Old architecture files (Selenium/Chrome) ──────────────────
main.py
debug_responses/
nginx_logs/