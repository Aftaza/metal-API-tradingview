# ── V2.1 Environment Variables ──────────────────────────────
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0

# Scraping tuning
SCRAPE_INTERVAL_SECONDS=5
SCRAPE_TIMEOUT_MS=30000
RECOVERY_DELAY_SECONDS=5
MAX_BACKOFF_SECONDS=60
RENDER_SETTLE_MS=600

# Redis TTL — keys expire after 60s if scraper stops writing
REDIS_KEY_TTL_SECONDS=60

# CORS — set to comma-separated origins for production
# Example: ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=*

# Nginx public port
NGINX_PORT=80