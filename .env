# ── Metal Price API v3 — httpx + BeautifulSoup Architecture ──
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0

# Scraping interval with jitter
# Actual interval = SCRAPE_INTERVAL_SECONDS ± (SCRAPE_INTERVAL_SECONDS * SCRAPE_JITTER_FACTOR)
SCRAPE_INTERVAL_SECONDS=30
SCRAPE_JITTER_FACTOR=0.3

# HTTP client timeout (seconds)
HTTP_TIMEOUT_SECONDS=20

# Recovery behaviour
RECOVERY_DELAY_SECONDS=5
MAX_CONSECUTIVE_FAILURES=5

# Data older than this (seconds) is flagged as stale in API responses
DATA_STALENESS_SECONDS=300

NGINX_PORT=80